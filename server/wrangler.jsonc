{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "filmroom-api",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,

  // KV: sessions, webhook de-duplication, customer -> account index. Create it once:  wrangler kv namespace create FILMROOM_KV
  // and paste the id below (see server/README.md).
  "kv_namespaces": [{ "binding": "KV", "id": "192acaf3e14241ebaef6df80f74cbfc2" }],

  // One Durable Object per signed-in user: the single writer of that user's plan and Free download count.
  "durable_objects": { "bindings": [{ "name": "ACCOUNT", "class_name": "Account" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Account"] }],

  // Cheap abuse limit on sign-in and checkout (20 requests a minute per key).
  "ratelimits": [{ "name": "RL", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } }],

  "observability": { "enabled": true },

  // Non-secret settings. Secrets (DODO_API_KEY, DODO_WEBHOOK_SECRET) are set with `wrangler secret put`, never written here.
  "vars": {
    "DODO_ENV": "test_mode",                         // "test_mode" or "live_mode": this one switch decides which Dodo API is called
    "GOOGLE_CLIENT_ID": "215546086872-dttuivggji3jcaif5tglc3uq2ndru0vk.apps.googleusercontent.com",
    "SITE_URL": "https://filmroom.in",
    "GA_MEASUREMENT_ID": "G-NWXGNCWTV6",             // Google Analytics: the server sends subscription events here (needs the GA_API_SECRET secret, see docs/ANALYTICS.md)
    "ALLOWED_ORIGINS": "https://filmroom.in,https://www.filmroom.in",
    // Dodo product ids for the CURRENT mode (test and live products have different ids).
    "PRODUCT_MONTHLY": "pdt_0NsmAclo8rlbC3hkeYMhj",
    "PRODUCT_YEARLY": "pdt_0NsmAcmhJy3KawECCqtXj",
    "PRODUCT_LIFETIME": "pdt_0NsmAcoihd3lDphUHZFfX"
  }
}
